# BioSpace Environment Configuration Example

# Database (Default: SQLite for local; PostgreSQL for production like Neon/Supabase)
# SQLite:
DATABASE_URL="file:./dev.db"
# PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/biospace?schema=public"

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clerk Authentication (Obtain from https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding"

# Admin Bootstrap Allowlist
ADMIN_EMAIL_ALLOWLIST="admin@biospace.com,founder@biospace.com"

# Stripe (Optional for subscription billing)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PRO_MONTHLY_PRICE_ID="price_..."
NEXT_PUBLIC_STRIPE_PRO_YEARLY_PRICE_ID="price_..."

