# BioSpace Environment Configuration Example

# Database (Default: SQLite for local; PostgreSQL for production like Neon/Supabase)
# SQLite:
DATABASE_URL="file:./dev.db"
# PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/biospace?schema=public"

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clerk Authentication (Obtain from https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/onboarding"

# Admin Bootstrap Allowlist
ADMIN_EMAIL_ALLOWLIST="shahuztech@gmail.com,admin@biospace.com,founder@biospace.com"

# Stripe (Digital Storefront & Subscription Billing)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
NEXT_PUBLIC_STRIPE_PRO_MONTHLY_PRICE_ID="price_..."
NEXT_PUBLIC_STRIPE_PRO_YEARLY_PRICE_ID="price_..."

# AI Creator Assistant Configuration (Gemini or OpenAI)
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Email Marketing & Newsletter Delivery (Resend / SMTP)
RESEND_API_KEY=""
EMAIL_FROM="BioSpace <newsletter@biospace.com>"

# Appointment Booking System Configuration
DEFAULT_BOOKING_TIMEZONE="UTC"
GOOGLE_MEET_AUTO_PROVISION="true"

# Custom Domain Management (Phase 05)
NEXT_PUBLIC_APP_URL="https://biospace.com"
CUSTOM_DOMAIN_CNAME_TARGET="cname.biospace.com"
CUSTOM_DOMAIN_A_RECORD="76.76.21.21"
SIMULATE_DNS_VERIFICATION="false"

# Spotify Profile Music Integration
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""



