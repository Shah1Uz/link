// Production PostgreSQL Schema for BioSpace
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. USER DOMAIN
// ==========================================

model User {
  id               String         @id @default(cuid())
  clerkId          String         @unique
  email            String         @unique
  name             String?
  avatar           String?
  role             String         @default("USER") // USER, ADMIN
  isSuspended      Boolean        @default(false)
  isBanned         Boolean        @default(false)
  subscriptionTier String         @default("FREE") // FREE, PRO
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  profile           Profile?
  subscription      Subscription?
  notifications     Notification[]
  activityLogs      ActivityLog[]
  auditLogs         AdminAuditLog[]
  moderationActions ModerationAction[]
  templatePurchases TemplatePurchase[]
  templateReviews   TemplateReview[]
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  resource  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ==========================================
// 2. PROFILE DOMAIN
// ==========================================

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username    String   @unique
  displayName String?
  bio         String?
  avatarUrl   String?
  bannerUrl   String?
  category    String   @default("CREATOR")
  verified    Boolean  @default(false)
  isPublished Boolean  @default(true)
  layout      String   @default("classic")
  customCss   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  links           Link[]
  collections     Collection[]
  theme           Theme?
  qrCode          QRCode?
  socialAccounts  SocialAccount[]
  customDomains   CustomDomain[]
  profileViews    ProfileView[]
  linkClicks      LinkClick[]
  dailyStatistics DailyStatistics[]
  products        Product[]
  orders          Order[]
  analyticsEvents AnalyticsEvent[]
  reports         Report[]

  @@index([username])
}

model Link {
  id             String      @id @default(cuid())
  profileId      String
  profile        Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  collectionId   String?
  collection     Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  title          String
  url            String
  description    String?
  icon           String?
  thumbnail      String?
  isEnabled      Boolean     @default(true)
  isPinned       Boolean     @default(false)
  position       Int         @default(0)
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  clicksCount    Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  linkClicks      LinkClick[]
  analyticsEvents AnalyticsEvent[]
  reports         Report[]

  @@index([profileId])
  @@index([collectionId])
}

model Collection {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  description String?
  position    Int      @default(0)
  isCollapsed Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  links       Link[]

  @@index([profileId])
}

model Theme {
  id                 String   @id @default(cuid())
  profileId          String   @unique
  profile            Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  backgroundColor    String   @default("#0f172a")
  backgroundType     String   @default("color")
  backgroundGradient String?
  backgroundImage    String?
  buttonStyle        String   @default("rounded")
  buttonColor        String   @default("#ffffff")
  buttonTextColor    String   @default("#0f172a")
  buttonBorderColor  String?
  buttonRadius       String   @default("16px")
  fontHeading        String   @default("Inter")
  fontBody           String   @default("Inter")
  textColor          String   @default("#ffffff")
  accentColor        String   @default("#22c55e")
  animationsEnabled  Boolean  @default(true)
  showBranding       Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model QRCode {
  id              String   @id @default(cuid())
  profileId       String   @unique
  profile         Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  foregroundColor String   @default("#000000")
  backgroundColor String   @default("#ffffff")
  logoUrl         String?
  downloadCount   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SocialAccount {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  platform    String
  username    String
  profileUrl  String
  connectedAt DateTime @default(now())

  @@index([profileId])
}

model CustomDomain {
  id         String   @id @default(cuid())
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  domain     String   @unique
  status     String   @default("PENDING")
  sslStatus  String   @default("PENDING")
  dnsRecords String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([profileId])
  @@index([domain])
}

// ==========================================
// 3. ANALYTICS DOMAIN
// ==========================================

model ProfileView {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  visitorId String
  referrer  String?
  device    String?
  browser   String?
  os        String?
  country   String?
  createdAt DateTime @default(now())

  @@index([profileId, createdAt])
}

model LinkClick {
  id        String   @id @default(cuid())
  linkId    String
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  visitorId String
  referrer  String?
  device    String?
  createdAt DateTime @default(now())

  @@index([linkId, createdAt])
  @@index([profileId, createdAt])
}

model DailyStatistics {
  id             String   @id @default(cuid())
  profileId      String
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date           DateTime
  views          Int      @default(0)
  uniqueVisitors Int      @default(0)
  clicks         Int      @default(0)
  ctr            Float    @default(0.0)
  createdAt      DateTime @default(now())

  @@unique([profileId, date])
  @@index([profileId])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  linkId    String?
  link      Link?    @relation(fields: [linkId], references: [id], onDelete: SetNull)
  type      String
  visitorId String
  referrer  String?
  device    String?
  browser   String?
  os        String?
  country   String?
  createdAt DateTime @default(now())

  @@index([profileId, createdAt])
  @@index([linkId, createdAt])
  @@index([type])
}

// ==========================================
// 4. ADMIN & MODERATION DOMAIN
// ==========================================

model AdminAuditLog {
  id             String   @id @default(cuid())
  adminId        String
  admin          User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminEmail     String
  action         String
  targetResource String
  targetId       String?
  details        String?
  ipAddress      String?
  createdAt      DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
}

model Report {
  id            String    @id @default(cuid())
  profileId     String?
  profile       Profile?  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  linkId        String?
  link          Link?     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  reporterEmail String?
  reason        String
  details       String?
  status        String    @default("PENDING")
  resolvedBy    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  moderationActions ModerationAction[]

  @@index([status])
}

model ModerationAction {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  reportId   String?
  report     Report?  @relation(fields: [reportId], references: [id], onDelete: SetNull)
  actionType String
  targetType String
  targetId   String
  reason     String?
  createdAt  DateTime @default(now())

  @@index([adminId])
}

model PlatformSettings {
  id                  String   @id @default("default")
  siteName            String   @default("BioSpace")
  siteDescription     String   @default("Everything you are, in one link.")
  logoUrl             String?
  defaultTheme        String   @default("modern-minimal")
  registrationEnabled Boolean  @default(true)
  maintenanceMode     Boolean  @default(false)
  maxFreeLinks        Int      @default(10)
  maxProLinks         Int      @default(100)
  customDomainEnabled Boolean  @default(true)
  announcementText    String?
  announcementActive  Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

// ==========================================
// 5. MARKETPLACE DOMAIN
// ==========================================

model TemplateCategory {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  icon        String?
  position    Int        @default(0)
  createdAt   DateTime   @default(now())

  templates   Template[]
}

model Template {
  id           String            @id @default(cuid())
  name         String
  slug         String            @unique
  categoryId   String?
  categoryRel  TemplateCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  category     String
  description  String
  previewImage String?
  layout       String            @default("classic")
  stylesJson   String
  price        Float             @default(0.0)
  isPro        Boolean           @default(false)
  isPublished  Boolean           @default(true)
  isFeatured   Boolean           @default(false)
  useCount     Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  purchases    TemplatePurchase[]
  reviews      TemplateReview[]
}

model TemplatePurchase {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId      String
  template        Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  price           Float
  currency        String   @default("USD")
  stripePaymentId String?
  createdAt       DateTime @default(now())

  @@unique([userId, templateId])
  @@index([userId])
}

model TemplateReview {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  rating     Int      @default(5)
  comment    String?
  createdAt  DateTime @default(now())

  @@index([templateId])
}

// ==========================================
// 6. COMMERCE & MONETIZATION DOMAIN
// ==========================================

model Product {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  description String?
  price       Float
  currency    String   @default("USD")
  imageUrl    String?
  fileUrl     String?
  externalUrl String?
  isDigital   Boolean  @default(true)
  isEnabled   Boolean  @default(true)
  position    Int      @default(0)
  salesCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      Order[]

  @@index([profileId])
}

model Order {
  id              String   @id @default(cuid())
  profileId       String
  profile         Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerEmail   String
  customerName    String?
  amount          Float
  currency        String   @default("USD")
  status          String   @default("COMPLETED")
  stripeSessionId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([profileId])
  @@index([productId])
}

model PaymentEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  eventType     String
  amount        Float?
  currency      String?
  payload       String
  status        String   @default("PROCESSED")
  createdAt     DateTime @default(now())

  @@index([eventType])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  plan                 String    @default("FREE")
  status               String    @default("ACTIVE")
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}
