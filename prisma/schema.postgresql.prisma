generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. USER DOMAIN
// ==========================================

model User {
  id               String         @id @default(cuid())
  clerkId          String         @unique
  email            String         @unique
  name             String?
  avatar           String?
  passwordHash     String?
  role             String         @default("USER") // USER, ADMIN
  isSuspended      Boolean        @default(false)
  isBanned         Boolean        @default(false)
  subscriptionTier String         @default("FREE") // FREE, PRO
  notifyClickMilestones Boolean   @default(true)
  notifyWeeklyDigest    Boolean   @default(true)
  notifyProductNews     Boolean   @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  profile           Profile?
  subscription      Subscription?
  notifications     Notification[]
  activityLogs      ActivityLog[]
  auditLogs         AdminAuditLog[]
  moderationActions ModerationAction[]
  templatePurchases TemplatePurchase[]
  templateReviews   TemplateReview[]
  supportTickets    SupportTicket[]
  contactInquiries  ContactInquiry[]
  ownedTeams        Team[]             @relation("TeamOwner")
  teamMemberships   TeamMember[]       @relation("TeamMemberUser")
  apiKeys           APIKey[]
  webhookEndpoints  WebhookEndpoint[]
  aiUsage           AIUsage?
  aiGenerations     AIGeneration[]
  aiSettings        AISettings?
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  resource  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ==========================================
// 2. PROFILE DOMAIN
// ==========================================

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username    String   @unique
  displayName String?
  bio         String?
  avatarUrl   String?
  bannerUrl   String?
  category    String   @default("CREATOR")
  verified    Boolean  @default(false)
  isPublished Boolean  @default(true)
  layout      String   @default("classic")
  customCss   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  links           Link[]
  collections     Collection[]
  theme           Theme?
  qrCode          QRCode?
  socialAccounts  SocialAccount[]
  customDomains   CustomDomain[]
  profileViews    ProfileView[]
  linkClicks      LinkClick[]
  dailyStatistics DailyStatistics[]
  products        Product[]
  orders          Order[]
  analyticsEvents AnalyticsEvent[]
  reports         Report[]

  // Newsletter / Subscription Block Configuration (Phase 03)
  newsletterEnabled        Boolean   @default(false)
  newsletterTitle          String    @default("Join my Newsletter")
  newsletterDescription    String?   @default("Get exclusive updates, insights, and new project releases straight to your inbox.")
  newsletterButtonText     String    @default("Subscribe")
  newsletterPlaceholder    String    @default("Enter your email address...")
  newsletterSuccessMessage String    @default("Thanks for subscribing! Check your email to confirm your subscription.")
  newsletterLayout         String    @default("card") // card, minimal, inline, hero
  subscribers              Subscriber[]

  // Appointment Booking Configuration (Phase 04)
  bookingEnabled           Boolean   @default(false)
  bookingTitle             String    @default("Book an Appointment")
  bookingDescription       String?   @default("Schedule a 1-on-1 consultation or video meeting with me.")
  bookingTimezone          String    @default("UTC")
  appointmentTypes         AppointmentType[]
  availabilityRules        AvailabilityRule[]
  bookings                 Booking[]

  // Store / Shop Configuration
  storeEnabled             Boolean   @default(true)

  @@index([username])
}

model Link {
  id             String      @id @default(cuid())
  profileId      String
  profile        Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  collectionId   String?
  collection     Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  title          String
  url            String
  description    String?
  icon           String?
  thumbnail      String?
  displayMode    String      @default("link") // "link" | "embed"
  isEnabled      Boolean     @default(true)
  isPinned       Boolean     @default(false)
  position       Int         @default(0)
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  clicksCount    Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  linkClicks      LinkClick[]
  analyticsEvents AnalyticsEvent[]
  reports         Report[]

  @@index([profileId])
  @@index([collectionId])
}

model Collection {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  description String?
  position    Int      @default(0)
  isCollapsed Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  links       Link[]

  @@index([profileId])
}

model Theme {
  id                 String   @id @default(cuid())
  profileId          String   @unique
  profile            Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  backgroundColor    String   @default("#0f172a")
  backgroundType     String   @default("color")
  backgroundGradient String?
  backgroundImage    String?
  backgroundVideo    String?
  buttonStyle        String   @default("rounded")
  buttonColor        String   @default("#ffffff")
  buttonTextColor    String   @default("#0f172a")
  buttonBorderColor  String?
  buttonRadius       String   @default("16px")
  fontHeading        String   @default("Inter")
  fontBody           String   @default("Inter")
  textColor          String   @default("#ffffff")
  accentColor        String   @default("#22c55e")
  animationsEnabled  Boolean  @default(true)
  showBranding       Boolean  @default(true)

  // Spotify Profile Music Integration
  spotifyMusicEnabled  Boolean  @default(false)
  spotifyTrackUrl      String?
  spotifyTrackTitle    String?
  spotifyTrackArtist   String?
  spotifyTrackImage    String?
  spotifyMusicLayout   String   @default("floating") // "floating" | "card"
  spotifyMusicAutoplay Boolean  @default(false)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model QRCode {
  id              String   @id @default(cuid())
  profileId       String   @unique
  profile         Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  foregroundColor String   @default("#000000")
  backgroundColor String   @default("#ffffff")
  logoUrl         String?
  downloadCount   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SocialAccount {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  platform    String   // youtube, instagram, twitter, github, spotify, tiktok
  username    String
  profileUrl  String
  connectedAt DateTime @default(now())

  @@index([profileId])
}

model CustomDomain {
  id              String               @id @default(cuid())
  profileId       String
  profile         Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  domain          String               @unique // Normalized lowercase (e.g. "links.example.com")
  status          String               @default("PENDING") // PENDING, VERIFYING, VERIFIED, PROVISIONING_SSL, ACTIVE, FAILED, SUSPENDED
  sslStatus       String               @default("PENDING") // PENDING, ISSUING, ACTIVE, FAILED
  cnameTarget     String               @default("cname.biospace.com")
  verificationTxt String               @default("") // Unique verification string: "biospace-verify-" + random hex
  verifiedAt      DateTime?
  lastCheckedAt   DateTime?
  errorMessage    String?
  retryCount      Int                  @default(0)
  isApex          Boolean              @default(false)
  dnsRecords      String?              // Cached DNS record snapshot
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  verifications   DomainVerification[]
  events          DomainEvent[]

  @@index([profileId])
  @@index([domain])
  @@index([status])
}

model DomainVerification {
  id          String       @id @default(cuid())
  domainId    String
  domain      CustomDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  type        String       @default("DNS_TXT") // DNS_TXT, DNS_CNAME
  recordName  String       // e.g. "_biospace" or "@"
  recordValue String
  status      String       @default("PENDING") // PENDING, SUCCESS, FAILED
  attemptedAt DateTime     @default(now())
  expiresAt   DateTime
  responseLog String?

  @@index([domainId])
  @@index([status])
}

model DomainEvent {
  id          String       @id @default(cuid())
  domainId    String
  domain      CustomDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  eventType   String       // CREATED, VERIFICATION_ATTEMPT, VERIFIED, SSL_PROVISIONED, ACTIVATED, FAILED, REMOVED, SUSPENDED
  description String
  metadata    String?      // JSON stringified metadata
  createdAt   DateTime     @default(now())

  @@index([domainId])
  @@index([eventType])
}

// ==========================================
// 3. ANALYTICS DOMAIN
// ==========================================

model ProfileView {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  visitorId String
  referrer  String?
  device    String?
  browser   String?
  os        String?
  country   String?
  createdAt DateTime @default(now())

  @@index([profileId, createdAt])
}

model LinkClick {
  id        String   @id @default(cuid())
  linkId    String
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  visitorId String
  referrer  String?
  device    String?
  createdAt DateTime @default(now())

  @@index([linkId, createdAt])
  @@index([profileId, createdAt])
}

model DailyStatistics {
  id             String   @id @default(cuid())
  profileId      String
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date           DateTime
  views          Int      @default(0)
  uniqueVisitors Int      @default(0)
  clicks         Int      @default(0)
  ctr            Float    @default(0.0)
  createdAt      DateTime @default(now())

  @@unique([profileId, date])
  @@index([profileId])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  linkId    String?
  link      Link?    @relation(fields: [linkId], references: [id], onDelete: SetNull)
  type      String
  visitorId String
  referrer  String?
  device    String?
  browser   String?
  os        String?
  country   String?
  createdAt DateTime @default(now())

  @@index([profileId, createdAt])
  @@index([linkId, createdAt])
  @@index([type])
}

// ==========================================
// 4. ADMIN & MODERATION DOMAIN
// ==========================================

model AdminAuditLog {
  id             String   @id @default(cuid())
  adminId        String
  admin          User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminEmail     String
  action         String
  targetResource String
  targetId       String?
  details        String?
  ipAddress      String?
  createdAt      DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
}

model Report {
  id            String    @id @default(cuid())
  profileId     String?
  profile       Profile?  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  linkId        String?
  link          Link?     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  reporterEmail String?
  reason        String
  details       String?
  status        String    @default("PENDING") // PENDING, RESOLVED, DISMISSED
  resolvedBy    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  moderationActions ModerationAction[]

  @@index([status])
}

model ModerationAction {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  reportId   String?
  report     Report?  @relation(fields: [reportId], references: [id], onDelete: SetNull)
  actionType String   // SUSPEND_USER, BAN_USER, REMOVE_LINK, DISMISS
  targetType String   // PROFILE, LINK, USER
  targetId   String
  reason     String?
  createdAt  DateTime @default(now())

  @@index([adminId])
}

model PlatformSettings {
  id                  String   @id @default("default")
  siteName            String   @default("BioSpace")
  siteDescription     String   @default("Everything you are, in one link.")
  logoUrl             String?
  defaultTheme        String   @default("modern-minimal")
  registrationEnabled Boolean  @default(true)
  maintenanceMode     Boolean  @default(false)
  maxFreeLinks        Int      @default(10)
  maxProLinks         Int      @default(100)
  customDomainEnabled Boolean  @default(true)
  announcementText    String?
  announcementActive  Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

// ==========================================
// 5. MARKETPLACE DOMAIN
// ==========================================

model TemplateCategory {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  icon        String?
  position    Int        @default(0)
  createdAt   DateTime   @default(now())

  templates   Template[]
}

model Template {
  id           String            @id @default(cuid())
  name         String
  slug         String            @unique
  categoryId   String?
  categoryRel  TemplateCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  category     String            // String representation for compatibility
  description  String
  previewImage String?
  layout       String            @default("classic")
  stylesJson   String
  price        Float             @default(0.0)
  isPro        Boolean           @default(false)
  isPublished  Boolean           @default(true)
  isFeatured   Boolean           @default(false)
  useCount     Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  purchases    TemplatePurchase[]
  reviews      TemplateReview[]
}

model TemplatePurchase {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId      String
  template        Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  price           Float
  currency        String   @default("USD")
  stripePaymentId String?
  createdAt       DateTime @default(now())

  @@unique([userId, templateId])
  @@index([userId])
}

model TemplateReview {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  rating     Int      @default(5)
  comment    String?
  createdAt  DateTime @default(now())

  @@index([templateId])
}

// ==========================================
// 6. COMMERCE & MONETIZATION DOMAIN
// ==========================================

model ProductCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
}

model Product {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  description String?
  price       Float
  currency    String   @default("USD")
  imageUrl    String?
  galleryUrls String?  // JSON array string of additional product images
  fileUrl     String?  // Download asset or digital course URL
  externalUrl String?  // External buy or checkout link
  type        String   @default("DIGITAL_DOWNLOAD") // DIGITAL_DOWNLOAD, EBOOK, COURSE, SERVICE, PHYSICAL, EXTERNAL
  category    String?  @default("General")
  categoryId  String?
  categoryRef ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  isDigital   Boolean  @default(true)
  isEnabled   Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  position    Int      @default(0)
  viewsCount  Int      @default(0)
  clicksCount Int      @default(0)
  salesCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      Order[]
  orderItems  OrderItem[]

  @@index([profileId])
  @@index([categoryId])
  @@index([type])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String?     @unique
  profileId       String
  profile         Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  productId       String
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerEmail   String
  customerName    String?
  amount          Float
  refundedAmount  Float?      @default(0)
  currency        String      @default("USD")
  status          String      @default("COMPLETED") // PENDING, COMPLETED, REFUNDED, FAILED
  stripeSessionId String?
  paymentIntentId String?
  metadata        String?     // JSON metadata (e.g. shipping or custom notes)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items           OrderItem[]

  @@index([profileId])
  @@index([productId])
  @@index([status])
  @@index([stripeSessionId])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  title     String
  price     Float
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model PaymentEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  eventType     String
  amount        Float?
  currency      String?
  payload       String
  status        String   @default("PROCESSED") // PROCESSED, FAILED, DUPLICATE
  orderId       String?
  createdAt     DateTime @default(now())

  @@index([eventType])
  @@index([orderId])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  plan                 String    @default("FREE")
  status               String    @default("ACTIVE")
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}


// ==========================================
// 7. ENTERPRISE: TEAMS, DEVELOPER & SUPPORT
// ==========================================

model SupportTicket {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject    String
  message    String
  status     String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority   String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  category   String   @default("GENERAL") // GENERAL, BILLING, TECHNICAL, ABUSE
  assignedTo String?
  response   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  isEnabled   Boolean  @default(true)
  rules       String?  // JSON string defining targeting rules
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model Team {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  ownerId   String
  owner     User         @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   TeamMember[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([ownerId])
  @@index([slug])
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation("TeamMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("MEMBER") // OWNER, ADMIN, EDITOR, VIEWER
  joinedAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model APIKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  keyPrefix  String
  scopes     String    @default("read:profile,write:links")
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([keyHash])
}

model WebhookEndpoint {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url          String
  secret       String
  events       String   // e.g. "profile.view,link.click,order.completed"
  isActive     Boolean  @default(true)
  failureCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// ==========================================
// 12. AI CREATOR ASSISTANT DOMAIN
// ==========================================

model AIUsage {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  period          String   // Format: "YYYY-MM" e.g. "2026-11"
  generationCount Int      @default(0)
  tokenCount      Int      @default(0)
  estimatedCost   Float    @default(0.0)
  lastUsedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([period])
}

model AIGeneration {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // BIO, HEADLINE, DESCRIPTION, LINK_TITLE, CONTENT_IMPROVE, THEME_RECOMMEND, PROFILE_OPTIMIZE, CTA
  prompt      String?
  inputJson   String   // Stored JSON parameters
  outputJson  String   // Stored JSON response / variations
  tokensUsed  Int      @default(0)
  costEst     Float    @default(0.0)
  provider    String   @default("gemini")
  model       String   @default("gemini-2.5-flash")
  status      String   @default("SUCCESS") // SUCCESS, FAILED
  isApplied   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model AISettings {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredLanguage String   @default("en") // en, uz, ru, es, etc.
  preferredTone     String   @default("creative") // professional, playful, minimalist, poetic, energetic
  defaultProvider   String   @default("gemini")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

// ==========================================
// 12. EMAIL MARKETING & SUBSCRIBERS DOMAIN (PHASE 03)
// ==========================================

model Subscriber {
  id                 String                  @id @default(cuid())
  profileId          String
  profile            Profile                 @relation(fields: [profileId], references: [id], onDelete: Cascade)
  email              String
  name               String?
  status             String                  @default("PENDING") // PENDING, ACTIVE, UNSUBSCRIBED, BOUNCED
  source             String                  @default("profile_page") // profile_page, checkout, embed
  subscribedAt       DateTime                @default(now())
  confirmedAt        DateTime?
  unsubscribedAt     DateTime?
  unsubscribeToken   String                  @unique @default(cuid())
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  consents           SubscriptionConsent[]
  verificationTokens EmailVerificationToken[]
  deliveryLogs       EmailDeliveryLog[]

  @@unique([profileId, email])
  @@index([profileId])
  @@index([email])
  @@index([status])
  @@index([unsubscribeToken])
}

model SubscriptionConsent {
  id           String     @id @default(cuid())
  subscriberId String
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  consentType  String     @default("EMAIL_MARKETING") // EMAIL_MARKETING, PRODUCT_UPDATES
  consentedAt  DateTime   @default(now())
  source       String     @default("profile_page")
  ipAddress    String?
  userAgent    String?
  consentText  String     @default("I agree to receive email updates and newsletters.")
  createdAt    DateTime   @default(now())

  @@index([subscriberId])
}

model EmailVerificationToken {
  id           String     @id @default(cuid())
  subscriberId String
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  token        String     @unique @default(cuid())
  type         String     @default("CONFIRMATION") // CONFIRMATION, LOGIN
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime   @default(now())

  @@index([subscriberId])
  @@index([token])
}

model EmailDeliveryLog {
  id             String      @id @default(cuid())
  subscriberId   String?
  subscriber     Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  recipientEmail String
  subject        String
  template       String      // CONFIRMATION, WELCOME, NOTIFICATION, UNSUBSCRIBE
  provider       String      @default("biospace_mail") // resend, smtp, biospace_mail
  status         String      @default("SENT") // SENT, DELIVERED, FAILED, SIMULATED
  error          String?
  messageId      String?
  createdAt      DateTime    @default(now())

  @@index([recipientEmail])
  @@index([template])
  @@index([status])
}

// ==========================================
// 14. APPOINTMENT BOOKING DOMAIN (Phase 04)
// ==========================================

model AppointmentType {
  id           String    @id @default(cuid())
  profileId    String
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  category     String    @default("CONSULTATION") // CONSULTATION, MEETING, COACHING, PERSONAL, SERVICE
  duration     Int       @default(30) // Duration in minutes: 15, 30, 45, 60, 90, 120
  bufferTime   Int       @default(10) // Buffer time between slots in minutes
  price        Float     @default(0) // 0 for free
  currency     String    @default("USD")
  locationType String    @default("GOOGLE_MEET") // GOOGLE_MEET, ZOOM, CUSTOM_URL, IN_PERSON, PHONE
  locationUrl  String?
  color        String?   @default("#3b82f6") // Accent color for cards/calendar
  isActive     Boolean   @default(true)
  position     Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bookings Booking[]

  @@index([profileId])
  @@index([isActive])
}

model AvailabilityRule {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  dayOfWeek Int      // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime String   @default("09:00") // 24-hour format "HH:mm"
  endTime   String   @default("17:00") // 24-hour format "HH:mm"
  isEnabled Boolean  @default(true)
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, dayOfWeek, startTime, endTime])
  @@index([profileId])
  @@index([dayOfWeek])
}

model Booking {
  id                 String               @id @default(cuid())
  profileId          String
  profile            Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  appointmentTypeId  String
  appointmentType    AppointmentType      @relation(fields: [appointmentTypeId], references: [id], onDelete: Restrict)
  customerName       String
  customerEmail      String
  customerPhone      String?
  customerNotes      String?
  startTime          DateTime
  endTime            DateTime
  status             String               @default("CONFIRMED") // CONFIRMED, CANCELLED, RESCHEDULED, COMPLETED
  meetingUrl         String?
  locationType       String               @default("GOOGLE_MEET")
  price              Float                @default(0)
  currency           String               @default("USD")
  isPaid             Boolean              @default(false)
  paymentReference   String?
  cancelToken        String               @unique @default(cuid())
  rescheduleToken    String               @unique @default(cuid())
  cancellationReason String?
  cancelledAt        DateTime?
  rescheduledFromId  String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  notifications BookingNotification[]

  @@index([profileId])
  @@index([appointmentTypeId])
  @@index([startTime])
  @@index([endTime])
  @@index([status])
  @@index([cancelToken])
  @@index([rescheduleToken])
}

model BookingNotification {
  id             String   @id @default(cuid())
  bookingId      String
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type           String   // NEW_BOOKING, CONFIRMATION, CANCELLATION, RESCHEDULED, REMINDER
  recipientEmail String
  recipientRole  String   @default("ATTENDEE") // CREATOR, ATTENDEE
  status         String   @default("SENT") // SENT, FAILED, SIMULATED
  subject        String
  content        String
  sentAt         DateTime @default(now())

  @@index([bookingId])
  @@index([recipientEmail])
  @@index([type])
}

model ContactInquiry {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String
  subject   String
  message   String
  category  String   @default("GENERAL")
  status    String   @default("OPEN")
  response  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([userId])
}

